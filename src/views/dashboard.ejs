<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>

        <p>
            <strong>Name:</strong>
            <%= name %>
        </p>

        <p>
            <strong>Username:</strong>
            <%= email %>
        </p>

        <hr>

<h3>Projects I Volunteered For</h3>

<% if (volunteeredProjects.length > 0) { %>
    <ul>
        <% volunteeredProjects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>

                -

                <%= project.organization_name %>

                <form
                    action="/project/<%= project.project_id %>/remove-volunteer"
                    method="POST"
                >
                    <button type="submit">
                        Remove Volunteer
                    </button>
                </form>
            </li>
        <% }) %>
    </ul>
<% } else { %>
    <p>
        You have not volunteered for any projects yet.
    </p>
<% } %>

        <% if (user && user.role_name==='admin' ) { %>

            <hr>

            <h3>Administration</h3>

            <ul>
                <li>
                    <a href="/users">
                        View All Users
                    </a>
                </li>
            </ul>

            <% } %>

    </main>

    <%- include('partials/footer') %>