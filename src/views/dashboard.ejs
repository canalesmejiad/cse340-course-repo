<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>

        <p>
            <strong>Name:</strong>
            <%= name %>
        </p>

        <p>
            <strong>Username:</strong>
            <%= email %>
        </p>

        <% if (user && user.role_name==='admin' ) { %>

            <hr>

            <h3>Administration</h3>

            <ul>
                <li>
                    <a href="/users">
                        View All Users
                    </a>
                </li>
            </ul>

            <% } %>

    </main>

    <%- include('partials/footer') %>