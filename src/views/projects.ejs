<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here are the next upcoming service projects:</p>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>

                -

                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>

                <p>
                    <strong>Date:</strong>
                    <%= project.date %>
                </p>

                <p>
                    <strong>Location:</strong>
                    <%= project.location %>
                </p>
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>