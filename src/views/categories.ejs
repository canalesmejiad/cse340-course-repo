<%- include('partials/header') %>

  <main>
    <h1>
      <%= title %>
    </h1>

    <%- include('partials/header') %>

      <main>
        <h1>
          <%= title %>
        </h1>

        <p>Here are the available service categories:</p>

        <% if (user && user.role_name==='admin' ) { %>
          <p>
            <a href="/new-category">
              Add a New Category
            </a>
          </p>
          <% } %>

            <ul>
              <% categories.forEach(category=> { %>
                <li>
                  <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                  </a>
                </li>
                <% }) %>
            </ul>
      </main>

      <%- include('partials/footer') %>

        <ul>
          <% categories.forEach(category=> { %>
            <li>
              <a href="/category/<%= category.category_id %>">
                <%= category.name %>
              </a>
            </li>
            <% }) %>
        </ul>
  </main>

  <%- include('partials/footer') %>