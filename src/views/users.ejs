<%- include('partials/header') %>

<main>
    <h1>
        <%= title %>
    </h1>

    <p>Here are all registered users in the system:</p>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
            </tr>
        </thead>

        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.role_name %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</main>

<%- include('partials/footer') %>